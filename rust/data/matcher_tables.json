  "cpv_to_nace_sources": {
    "_comment": "Where the CPV group -> NACE division pairs come from. The original pairs follow the Commission's CPV<->NACE correspondence; the `empirical` pairs were derived 2026-10-19 from Belgian contract-award notices and validated on a held-out half. Re-derive with the commands in docs/mission.md.",
    "empirical": {
      "query": "buyer-country=BEL AND notice-type=can-standard AND publication-date>=20240101, harvested month by month because TED refuses pages beyond ~61",
      "awards": 16135,
      "awards_with_cpv_and_winner": 9195,
      "winners_matched_in_kbo": 5075,
      "notices_used": 8615,
      "rule": "support >= 10 award notices and lift = P(cpv group | division) / P(cpv group) >= 3.0",
      "held_out": "odd/even publication number split; a pair is kept only if the other half also shows support >= 5 and lift >= 3.0",
      "pairs_added": 21,
      "reach": "companies that can match no CPV group: 16.1% -> 0.8% in a 20,000-company sample; mean share of notices a company can match: 5.8% -> 11.6%",
      "class_level": {
        "_comment": "CPV class (4 digits) -> NACE class (4 digits), derived the same way but finer, so a pharmacy (NACE 4773) and a supermarket (4711) are no longer the same company.",
        "pairs": 159,
        "cpv_classes": 88,
        "rule": "same rule and same odd/even held-out split as the division-level pairs, at 4-digit granularity: support >= 10, lift >= 3.0 on both halves",
        "scoring": "a class-level match is stronger evidence than a division-level one; see activity_scores in this file"
      },
      "division_pairs": 141,
      "class_pairs": 159
    },
    "wave2": {
      "_comment": "Second empirical wave, 2026-10-23: same support>=10/lift>=3.0 rule on both halves, but temporal halves (years <=2019 vs >=2020) over the ted_awards_history table (38,177 rows 2017-2021, exact+normalized unambiguous joins) instead of odd/even publication numbers.",
      "pairs_added_division": 14,
      "pairs_added_class": 26,
      "reach_breadth": "unchanged (0.9% of NACE-having companies match nothing before and after — wave 1 saturated breadth)",
      "reach_depth": "mean share of CPV groups matchable per company 3.06% -> 3.45% on a 20,000-enterprise sample"
    }
  },
